NODE_ENV=production
PORT=8080
DATABASE_URL=postgres://hozorban:change_this_password@db:5432/hozorban
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
CORS_ORIGIN=https://your-domain.example

# Number of reverse-proxy hops in front of the API, or an Express subnet list.
# Leave empty when the API is reached directly; set 1 behind a single nginx/CDN.
# A value that is too high lets clients spoof X-Forwarded-For and bypass limits.
TRUST_PROXY=

# Public frontend URL used inside password-reset emails (no trailing slash).
APP_BASE_URL=https://your-domain.example
PASSWORD_RESET_TTL_MINUTES=30
# Lifetime of an access token. Shorter values reduce the impact of a stolen
# token but force users to sign in again; 8h matches a normal work day.
AUTH_TOKEN_TTL=8h

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-before-production

# Optional platform (super admin) bootstrap. Set both once and run migrations;
# re-running migrations keeps the account in sync. This account can log in at
# /#/platform and manage every faculty.
PLATFORM_ADMIN_EMAIL=platform@example.com
PLATFORM_ADMIN_PASSWORD=change-this-before-production

# SMTP delivery for temporary passwords and password-reset links.
# In production temporary passwords are never returned by the API, so SMTP is
# required for new account/reset delivery. Without SMTP they are only logged
# to the server console (development fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Number of previous passwords that may not be reused (default 5).
PASSWORD_HISTORY_LIMIT=5
