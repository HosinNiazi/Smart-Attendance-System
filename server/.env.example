NODE_ENV=production
PORT=8080
DATABASE_URL=postgres://hozorban:change_this_password@db:5432/hozorban
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
CORS_ORIGIN=https://your-domain.example
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-before-production

# Optional SMTP delivery for temporary teacher passwords.
# If SMTP_HOST is not set, temporary passwords are logged to the server console
# instead of emailed and are still returned in the API response for manual delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Number of previous passwords that may not be reused (default 5).
PASSWORD_HISTORY_LIMIT=5
