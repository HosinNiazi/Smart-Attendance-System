# Security headers for the static frontend (Netlify / Cloudflare Pages style).
# If the API lives on another origin, add that origin to connect-src.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob:; media-src 'self' blob: data:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self), payment=(), usb=(), accelerometer=(), gyroscope=()
  Cross-Origin-Opener-Policy: same-origin
  X-XSS-Protection: 0

# face-api loads model manifests and .bin weight files with fetch(). Serve them
# as inline download-free responses with an explicit content type.
/models/*
  Content-Disposition: inline
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=31536000, immutable

/models/*.bin
  Content-Type: application/octet-stream
